:root {
  --el-green: #168447;
  --el-dark: #123c2b;
  --el-orange: #f39b36;
  --el-muted: #718078;
  --el-border: #e8eee9;
  --el-bg: #f8faf7;
}

.el-home {
  min-height: 100vh;
  background: #fff;
  color: #20352a;
  font-family: Inter, "Noto Sans Bengali", "Hind Siliguri", Arial, sans-serif;
  padding-bottom: 0;
}

.el-home * { box-sizing: border-box; }
.el-home button { font: inherit; cursor: pointer; }
.el-home button:focus-visible,
.el-home input:focus-visible {
  outline: 3px solid #a8dfba;
  outline-offset: 3px;
}

.el-top-strip {
  min-height: 34px;
  padding: 8px 5%;
  background: var(--el-dark);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 12px;
}

.el-header {
  min-height: 82px;
  padding: 14px 5%;
  display: flex;
  align-items: center;
  gap: 28px;
  border-bottom: 1px solid var(--el-border);
  background: #fff;
}

.el-brand {
  display: flex;
  align-items: center;
  gap: 9px;
  border: 0;
  padding: 0;
  background: transparent;
  color: var(--el-dark);
  flex-shrink: 0;
}

.el-brand-mark {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  background: #e9f7ec;
  color: var(--el-green);
  border-radius: 14px;
  font-size: 29px;
}

.el-brand-name {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  font-size: 19px;
  letter-spacing: -.7px;
}

.el-brand-name b { color: var(--el-green); }
.el-brand-name strong { color: var(--el-orange); }
.el-brand-name small {
  width: 100%;
  font-size: 8px;
  letter-spacing: 2px;
  text-align: left;
  color: var(--el-muted);
}

.el-address {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 12px;
  border: 1px solid var(--el-border);
  border-radius: 12px;
  background: #fff;
  text-align: left;
  min-width: 170px;
}

.el-location-icon { font-size: 25px; color: var(--el-green); }
.el-address small, .el-address strong { display: block; }
.el-address small { color: var(--el-muted); font-size: 11px; }
.el-address strong { font-size: 12px; margin-top: 3px; }

.el-desktop-nav {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-left: auto;
}

.el-desktop-nav button {
  border: 0;
  background: transparent;
  padding: 11px 12px;
  border-radius: 9px;
  font-size: 13px;
  color: #56645b;
}

.el-desktop-nav button.active,
.el-desktop-nav button:hover {
  color: var(--el-green);
  background: #eff8f0;
}

.el-header-actions { display: flex; align-items: center; gap: 8px; }
.el-header-actions button {
  position: relative;
  width: 39px;
  height: 39px;
  border: 1px solid var(--el-border);
  border-radius: 12px;
  background: #fff;
  color: var(--el-dark);
  font-size: 23px;
}
.el-header-actions button:hover { background: #f0f8f1; }
.el-header-actions .el-cart-button { font-size: 18px; }
.el-cart-button span {
  position: absolute;
  right: -5px;
  top: -6px;
  min-width: 19px;
  height: 19px;
  padding: 2px 4px;
  border-radius: 20px;
  color: #fff;
  background: var(--el-green);
  font-size: 10px;
  line-height: 15px;
}

.el-home main { max-width: 1440px; margin: 0 auto; }

.el-hero {
  margin: 28px 5% 22px;
  padding: 46px 5%;
  min-height: 410px;
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  align-items: center;
  gap: 25px;
  position: relative;
  overflow: hidden;
  border-radius: 25px;
  background: linear-gradient(120deg, #eff9ed 0%, #f8fbef 56%, #e2f2df 100%);
}

.el-hero-copy { position: relative; z-index: 2; }
.el-eyebrow, .el-section-kicker {
  font-size: 10px;
  letter-spacing: 1.5px;
  font-weight: 800;
  color: var(--el-green);
}
.el-eyebrow { display: flex; align-items: center; gap: 8px; }
.el-eyebrow span {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--el-orange);
}

.el-hero h1 {
  margin: 18px 0 13px;
  color: var(--el-dark);
  font-size: clamp(37px, 4.4vw, 62px);
  line-height: 1.18;
  letter-spacing: -2px;
}
.el-hero h1 span { color: var(--el-green); }
.el-hero-copy > p {
  max-width: 460px;
  margin: 0;
  color: #607267;
  line-height: 1.9;
  font-size: 14px;
}

.el-hero-buttons { display: flex; gap: 11px; flex-wrap: wrap; margin-top: 25px; }
.el-primary-button, .el-secondary-button {
  border-radius: 11px;
  padding: 13px 19px;
  font-weight: 750;
  font-size: 13px;
}
.el-primary-button {
  border: 1px solid var(--el-green);
  background: var(--el-green);
  color: #fff;
  box-shadow: 0 7px 17px #16844726;
}
.el-primary-button:hover { background: #106d39; }
.el-primary-button span { margin-left: 10px; }
.el-secondary-button {
  border: 1px solid #d8e7d9;
  background: #fff;
  color: var(--el-dark);
}
.el-secondary-button:hover { border-color: var(--el-green); }

.el-benefits {
  margin-top: 25px;
  display: flex;
  gap: 17px;
  flex-wrap: wrap;
  color: #5c6d61;
  font-size: 11px;
}
.el-benefits b { color: var(--el-green); margin-right: 4px; }

.el-hero-visual {
  position: relative;
  min-height: 290px;
  display: grid;
  place-items: center;
}
.el-hero-orbit {
  position: absolute;
  width: 330px; height: 330px;
  border-radius: 50%;
  background: #d4edcc;
  border: 1px solid #c4e3bb;
}
.el-hero-visual > img {
  position: relative;
  z-index: 1;
  width: min(100%, 410px);
  height: 290px;
  object-fit: cover;
  border-radius: 45% 45% 22px 22px;
  box-shadow: 0 16px 35px #173f2524;
}
.el-hero-note {
  position: absolute;
  z-index: 2;
  left: -4px;
  bottom: 12px;
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 11px 14px;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 7px 24px #193c241c;
}
.el-hero-note > span { font-size: 25px; }
.el-hero-note strong, .el-hero-note small { display: block; }
.el-hero-note strong { font-size: 12px; }
.el-hero-note small { margin-top: 4px; color: var(--el-muted); font-size: 10px; }
.el-hero-badge {
  position: absolute;
  z-index: 2;
  top: 10px;
  right: 0;
  width: 65px;
  height: 65px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #fff;
  background: var(--el-orange);
  border: 4px solid #fff;
  box-shadow: 0 6px 16px #7b561f20;
}
.el-hero-badge b { font-size: 24px; line-height: 25px; }
.el-hero-badge span { font-size: 9px; font-weight: 800; }

.el-service-note {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  margin-top: -2px;
  padding: 10px 14px;
  background: #fff;
  border: 1px solid #e2efe0;
  border-radius: 12px;
}
.el-service-note > span { font-size: 22px; color: var(--el-green); }
.el-service-note strong, .el-service-note small { display: block; }
.el-service-note strong { color: var(--el-dark); font-size: 11px; }
.el-service-note small { color: var(--el-muted); font-size: 9px; margin-top: 3px; }

.el-search-area { margin: 34px 5% 40px; }
.el-search-area > label { display: block; margin-bottom: 12px; font-size: 19px; font-weight: 800; }
.el-search-box {
  min-height: 54px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 15px;
  border: 1px solid #dfe9df;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 5px 18px #163d2010;
}
.el-search-box > span { color: var(--el-green); font-size: 28px; }
.el-search-box input {
  flex: 1; min-width: 0;
  border: 0; outline: none;
  background: transparent;
  color: var(--el-dark);
  font: inherit;
  font-size: 13px;
}
.el-search-box button { border: 0; background: transparent; color: var(--el-green); font-size: 12px; }

.el-section { margin: 0 5% 46px; }
.el-section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}
.el-section-heading h2 {
  margin: 7px 0 0;
  font-size: clamp(21px, 2.3vw, 28px);
  color: var(--el-dark);
  letter-spacing: -.5px;
}
.el-text-link {
  border: 0;
  background: transparent;
  color: var(--el-green);
  font-weight: 750;
  font-size: 12px;
  white-space: nowrap;
}
.el-text-link:hover { text-decoration: underline; }

.el-category-grid {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 13px;
}
.el-category-card {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  padding: 17px 7px;
  border: 1px solid #edf0eb;
  border-radius: 15px;
  background: #fff;
  color: var(--el-dark);
  transition: transform .18s ease, box-shadow .18s ease;
}
.el-category-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 22px #1c492011;
  border-color: #cfe5d0;
}
.el-category-icon {
  display: grid;
  place-items: center;
  width: 57px; height: 57px;
  border-radius: 17px;
  background: var(--category-bg);
  font-size: 29px;
}
.el-category-card strong { font-size: 12px; text-align: center; }
.el-category-card small { color: var(--el-muted); font-size: 10px; text-align: center; }

.el-product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 17px;
}
.el-product {
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 12px;
  border: 1px solid #e9eee9;
  border-radius: 17px;
  background: #fff;
  transition: box-shadow .2s ease, transform .2s ease;
}
.el-product:hover {
  transform: translateY(-3px);
  box-shadow: 0 9px 26px #173d2010;
}
.el-product-image {
  width: 100%;
  padding: 0;
  border: 0;
  background: #f5f7f3;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 1 / .82;
}
.el-product-image img {
  display: block;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform .25s ease;
}
.el-product:hover .el-product-image img { transform: scale(1.04); }
.el-heart {
  position: absolute;
  z-index: 2;
  top: 19px; right: 19px;
  display: grid;
  place-items: center;
  width: 31px; height: 31px;
  border: 1px solid #e7ebe6;
  border-radius: 50%;
  background: #fff;
  color: #68766c;
  font-size: 19px;
}
.el-heart.is-favorite { color: #e45151; background: #fff3f3; }
.el-product-tag {
  position: absolute;
  z-index: 2;
  top: 20px; left: 18px;
  padding: 5px 7px;
  border-radius: 6px;
  background: #e5f6e6;
  color: #14713c;
  font-size: 9px;
  font-weight: 800;
}
.el-product-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  min-height: 48px;
  padding: 11px 0 0;
  border: 0;
  background: transparent;
  color: var(--el-dark);
  text-align: left;
}
.el-product-title strong {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
}
.el-product-title span {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--el-muted);
  font-size: 10px;
}
.el-unit { margin-top: 9px; color: var(--el-muted); font-size: 10px; }
.el-price-line {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 7px;
}
.el-price-line strong { color: var(--el-green); font-size: 16px; }
.el-price-line del { color: #99a39b; font-size: 10px; }
.el-add-button {
  margin-top: 11px;
  width: 100%;
  padding: 9px 10px;
  border: 1px solid #b7dfbf;
  border-radius: 9px;
  background: #eff9f0;
  color: var(--el-green);
  font-weight: 800;
  font-size: 12px;
}
.el-add-button:hover { background: var(--el-green); color: #fff; }

.el-view-more-wrap { display: flex; justify-content: center; margin-top: 22px; }
.el-view-more {
  padding: 11px 24px;
  border: 1px solid #d4e7d6;
  border-radius: 11px;
  background: #fff;
  color: var(--el-green);
  font-size: 12px;
  font-weight: 800;
}
.el-view-more:hover { background: #eff8ef; }

.el-empty {
  text-align: center;
  padding: 35px 15px;
  border-radius: 16px;
  background: var(--el-bg);
}
.el-empty > span { font-size: 36px; }
.el-empty h3 { margin-bottom: 6px; }
.el-empty p { color: var(--el-muted); font-size: 13px; }

.el-bottom-banner {
  margin: 0 5% 48px;
  padding: 28px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-radius: 19px;
  background: #eaf6e9;
}
.el-bottom-banner > div > span { color: var(--el-green); font-size: 9px; font-weight: 800; letter-spacing: 1.5px; }
.el-bottom-banner h2 { margin: 8px 0; color: var(--el-dark); font-size: 23px; }
.el-bottom-banner p { margin: 0; color: #637568; font-size: 12px; }
.el-bottom-banner button {
  flex-shrink: 0;
  border: 0;
  border-radius: 10px;
  padding: 13px 17px;
  background: var(--el-green);
  color: #fff;
  font-size: 12px;
  font-weight: 800;
}

.el-footer {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr;
  gap: 30px;
  padding: 38px 5% 20px;
  background: #103b29;
  color: #fff;
}
.el-footer-brand > strong { font-size: 20px; }
.el-footer-brand > strong span { color: #a5dfa5; }
.el-footer-brand p { max-width: 260px; color: #c6d9cb; font-size: 12px; line-height: 1.8; }
.el-footer > div:not(.el-footer-brand):not(.el-copyright) { display: flex; flex-direction: column; gap: 12px; }
.el-footer > div > strong { font-size: 12px; margin-bottom: 4px; }
.el-footer > div > button {
  width: fit-content;
  padding: 0;
  border: 0;
  background: transparent;
  color: #c6d9cb;
  text-align: left;
  font-size: 11px;
}
.el-footer > div > button:hover { color: #fff; }
.el-footer-area { align-self: center; color: #d7eadb; font-size: 11px; }
.el-copyright {
  grid-column: 1 / -1;
  padding-top: 17px;
  border-top: 1px solid #ffffff24;
  color: #b6cdbd;
  font-size: 10px;
}

.el-mobile-nav { display: none; }
.el-toast {
  position: fixed;
  z-index: 100;
  left: 50%;
  bottom: 24px;
  transform: translateX(-50%);
  max-width: calc(100% - 30px);
  padding: 13px 20px;
  border-radius: 12px;
  background: #123c2b;
  color: #fff;
  box-shadow: 0 8px 28px #0002;
  font-size: 13px;
  text-align: center;
}

@media (min-width: 1440px) {
  .el-hero { margin-top: 35px; }
}

@media (max-width: 1150px) {
  .el-header { gap: 13px; }
  .el-address { min-width: 145px; }
  .el-desktop-nav button { padding: 10px 8px; font-size: 12px; }
  .el-category-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .el-product-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
}

@media (max-width: 800px) {
  .el-top-strip { padding: 8px 4%; font-size: 10px; }
  .el-header { padding: 13px 4%; min-height: auto; flex-wrap: wrap; }
  .el-brand { margin-right: auto; }
  .el-address { order: 3; width: 100%; }
  .el-desktop-nav { display: none; }
  .el-header-actions { gap: 6px; }
  .el-header-actions button { width: 35px; height: 35px; }
  .el-hero {
    margin: 17px 4% 20px;
    padding: 28px 22px 20px;
    grid-template-columns: 1fr;
    gap: 14px;
    border-radius: 20px;
  }
  .el-hero h1 { font-size: clamp(35px, 8vw, 52px); }
  .el-hero-copy > p { font-size: 13px; }
  .el-hero-visual { min-height: 240px; margin: 3px 0; }
  .el-hero-visual > img { width: min(88%, 360px); height: 225px; }
  .el-hero-orbit { width: 260px; height: 260px; }
  .el-hero-note { left: 0; bottom: 4px; }
  .el-hero-badge { right: 2%; top: 0; width: 58px; height: 58px; }
  .el-service-note { margin-top: 4px; }
  .el-search-area, .el-section { margin-left: 4%; margin-right: 4%; }
  .el-category-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; }
  .el-category-card { padding: 12px 4px; border-radius: 12px; }
  .el-category-icon { width: 47px; height: 47px; border-radius: 14px; font-size: 25px; }
  .el-category-card strong { font-size: 11px; }
  .el-category-card small { font-size: 9px; }
  .el-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .el-product { padding: 9px; border-radius: 13px; }
  .el-product-title strong { font-size: 12px; }
  .el-heart { top: 14px; right: 14px; width: 29px; height: 29px; }
  .el-product-tag { top: 15px; left: 14px; }
  .el-bottom-banner { margin: 0 4% 30px; padding: 23px 18px; align-items: flex-start; flex-direction: column; }
  .el-bottom-banner h2 { font-size: 20px; }
  .el-footer { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 25px 18px; padding: 28px 5% 20px; }
  .el-mobile-nav {
    position: fixed;
    z-index: 50;
    bottom: 0; left: 0; right: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 8px 4px max(8px, env(safe-area-inset-bottom));
    border-top: 1px solid #e6eee7;
    background: #fff;
    box-shadow: 0 -5px 18px #193c240a;
  }
  .el-mobile-nav button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 3px 0;
    border: 0;
    background: transparent;
    color: #77847a;
    font-size: 9px;
  }
  .el-mobile-nav button span { font-size: 22px; line-height: 25px; }
  .el-mobile-nav button.selected { color: var(--el-green); font-weight: 800; }
  .el-home { padding-bottom: 73px; }
  .el-toast { bottom: 85px; }
}

@media (max-width: 380px) {
  .el-top-strip span:first-child { max-width: 55%; }
  .el-brand-mark { width: 36px; height: 36px; }
  .el-brand-name { font-size: 16px; }
  .el-header-actions button { width: 31px; height: 33px; }
  .el-hero { padding: 24px 16px 17px; }
  .el-hero-buttons { gap: 8px; }
  .el-primary-button, .el-secondary-button { padding: 12px; font-size: 11px; }
  .el-benefits { gap: 9px; font-size: 9px; }
  .el-category-grid { gap: 6px; }
  .el-category-icon { width: 41px; height: 41px; font-size: 22px; }
  .el-category-card strong { font-size: 10px; }
  .el-category-card small { font-size: 8px; }
  .el-section-heading { align-items: center; }
  .el-text-link { font-size: 10px; }
}
